# Copiá este archivo a .env.local y completalo. Nunca subas .env.local al repo.

# URL pública del sitio (canonicals, sitemap y Open Graph). Sin barra final.
# Local: http://localhost:3000. Preview/producción: la URL real, por ejemplo https://luprey.com.uy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "preview" (por defecto) o "production".
# Si NO es "production": robots.txt bloquea todo, las páginas llevan noindex/nofollow
# y se muestra la franja "Versión preliminar" arriba de todo.
NEXT_PUBLIC_SITE_ENV=preview

# Solo para los scripts de descarga (scripts/fetch-images.mjs y fetch-videos.mjs). No llega al sitio.
PIXABAY_API_KEY=
